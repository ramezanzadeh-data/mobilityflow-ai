# Copy this file to .env and fill in real values for your environment.
# Never commit an actual .env file.
# None of the placeholder-looking values below (change_me, admin, ...)
# will actually work: auth/jwt.py and auth/encryption.py refuse to
# start if JWT_SECRET_KEY/ENCRYPTION_KEY are missing or still equal to
# a known placeholder, and docker-compose.yml refuses to start any
# service if POSTGRES_PASSWORD/MINIO_ROOT_PASSWORD/DEFAULT_ADMIN_* are
# unset. Generate real values before starting the app.

# --- Database (PostgreSQL) ---
# These values are for clients running directly on your machine
# (pytest, scripts/*, a locally started Streamlit or uvicorn).
# docker-compose.yml sets PGHOST/PGPORT itself for the containers, so
# nothing here affects them.
#
# Port 5433, not 5432: docker-compose.yml publishes the postgres
# container on 127.0.0.1:5433 so it cannot collide with a PostgreSQL
# service installed natively on the host, which normally owns 5432.
#
# Either set DATABASE_URL directly...
# DATABASE_URL=postgresql://mobilityflow:<POSTGRES_PASSWORD>@localhost:5433/mobilityflow
# ...or set the individual PG* variables (used if DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5433
PGDATABASE=mobilityflow
PGUSER=mobilityflow
# Also used directly by docker-compose.yml to start the postgres
# container itself, so POSTGRES_PASSWORD and PGPASSWORD below must be
# set to the SAME value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
PGPASSWORD=

# --- Background workers (Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 or MinIO) ---
# Leave S3_ENDPOINT_URL unset to use real AWS S3. Set it to point at
# MinIO (or any other S3-compatible store) instead.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=mobilityflow-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mobilityflow
# Also used directly by docker-compose.yml to start the MinIO
# container itself, so MINIO_ROOT_PASSWORD and S3_SECRET_ACCESS_KEY
# below must be set to the SAME value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MINIO_ROOT_PASSWORD=
S3_SECRET_ACCESS_KEY=

# --- First-run bootstrap admin ---
# Only used the very first time the app starts against an empty database.
# The bootstrap account is created with must_change_password=true, so
# it will be forced to change on first login - but still pick a real
# password here, not "admin". Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(16))"
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_COMPANY=Default Company

# --- Auth ---
# Required. The app refuses to start without a real value here - see
# auth/jwt.py. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Browser session (the HttpOnly cookie behind the Streamlit app) ---
# All optional; the defaults are the right answer for almost every
# deployment. See auth/browser_session.py.
#
# How long a signed-in browser stays signed in. Deliberately hours, not
# the thirty days above: that token is held by a server-to-server client,
# this one is held by a browser on somebody's desk.
# MOBILITYFLOW_BROWSER_SESSION_HOURS=12
#
# How long a session survives with nobody using it. Both this and the
# cap above apply, and this is the one that matters on a shared machine:
# durable sessions mean closing the window is no longer a logout, so
# without it an unattended browser stays signed in for the rest of the
# working day. The value worth tuning per customer - it trades against
# interrupting someone reading a long case file.
# MOBILITYFLOW_SESSION_IDLE_MINUTES=30
#
# Whether the session cookie is marked Secure.
#   auto  (default) - Secure when the request arrived over HTTPS, which
#                     nginx reports via X-Forwarded-Proto. Correct for
#                     both TLS production and http://localhost.
#   true            - always. Set this if a proxy in front of nginx
#                     strips X-Forwarded-Proto.
#   false           - never. Plain-HTTP development only.
# MOBILITYFLOW_SESSION_COOKIE_SECURE=auto
#
# Where the API answers as the browser sees it. Matches the location
# block in deploy/nginx.conf; only change this if that changes.
# MOBILITYFLOW_API_BASE_PATH=/api

# --- Ollama (LLM runtime) ---
# Ollama runs on the Docker host, not inside a container. Used by
# core/ai/ollama_client.py and read natively by the `ollama` Python
# client, so this single variable configures every Ollama caller.
# From inside Docker (Docker Desktop, or Linux via host-gateway):
OLLAMA_HOST=http://host.docker.internal:11434
# When running the app directly on your machine instead, use:
# OLLAMA_HOST=http://localhost:11434

# --- Field-level encryption (sensitive case/document data at rest) ---
# Required. The app refuses to start without a real value here - see
# auth/encryption.py. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up somewhere durable (secrets manager): losing it makes
# all previously-encrypted data permanently unreadable.
ENCRYPTION_KEY=